#define ZMK_POINTING_DEFAULT_MOVE_VAL 8000  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 20

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        bluetooth {
            bindings = <&mo 5>;
            key-positions = <40 43>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
  &kp LALT    &kp Q           &kp W        &kp E             &kp R        &kp T      &kp Y      &kp U        &kp I              &kp O        &kp P               &kp BSPC
  &kp LSHIFT  &hm LEFT_ALT A  &hm LCTRL S  &hm LEFT_SHIFT D  &hm LWIN F   &kp G      &kp H      &hm RWIN J   &hm RIGHT_SHIFT K  &hm RCTRL L  &hm RIGHT_ALT SEMI  &kp RSHFT
  &kp LCTRL   &kp Z           &kp X        &kp C             &kp V        &kp B      &kp N      &kp M        &kp COMMA          &kp DOT      &kp SQT             &kp DELETE
  &none       &none           &none        &mt LWIN ESC      &lt 1 SPACE  &lt 3 TAB  &kp ENTER  &lt 2 SPACE  &mo 4              &none        &none               &none
            >;
        };

        function {
            bindings = <
  &trans  &kp F1       &kp F2   &kp F3       &kp F4   &kp F5       &none   &none   &none   &none  &none  &trans
  &trans  &kp F6       &kp F7   &kp F8       &kp F9   &kp F10      &none   &none   &none   &none  &none  &trans
  &trans  &kp LS(F11)  &kp F11  &kp LS(F12)  &kp F12  &kp LC(F12)  &none   &none   &none   &none  &none  &trans
  &none   &none        &none    &trans       &trans   &trans       &trans  &trans  &trans  &none  &none  &none
            >;
        };

        row {
            bindings = <
  &trans  &none         &none      &none           &none     &none   &none           &kp PAGE_UP     &kp UP     &kp PAGE_DOWN  &kp INS      &trans
  &trans  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &kp LWIN  &none   &kp LS(LG(S))   &kp LEFT_ARROW  &kp DOWN   &kp RIGHT      &kp LS(INS)  &trans
  &trans  &none         &none      &none           &none     &none   &kp LS(LG(N4))  &kp HOME        &kp LSHFT  &kp END        &none        &trans
  &none   &none         &none      &trans          &trans    &trans  &trans          &trans          &trans     &none          &none        &none
            >;
        };

        number {
            bindings = <
  &trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N7  &kp N8  &kp N9  &none    &none      &trans
  &trans  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp N4  &kp N5  &kp N6  &kp N0   &none      &trans
  &trans  &none   &none   &none   &none   &none   &kp N1  &kp N2  &kp N3  &kp DOT  &kp COMMA  &trans
  &none   &none   &none   &trans  &trans  &trans  &trans  &trans  &trans  &none    &none      &none
            >;
        };

        simbol {
            bindings = <
  &trans  &kp EXCL   &kp AT    &kp LBKT  &kp RBKT  &kp PRCNT  &kp CARET  &kp BSLH   &kp SLASH  &kp ASTRK  &kp QMARK  &trans
  &trans  &kp HASH   &kp DLLR  &kp LPAR  &kp RPAR  &kp AMPS   &kp PIPE   &kp EQUAL  &kp PLUS   &kp MINUS  &kp COLON  &trans
  &trans  &kp GRAVE  &none     &kp LBRC  &kp RBRC  &none      &kp TILDE  &kp UNDER  &kp LT     &kp GT     &kp DQT    &trans
  &none   &none      &none     &trans    &trans    &trans     &trans     &trans     &trans     &none      &none      &none
            >;
        };

        adjust {
            bindings = <
  &none  &bt BT_PRV    &bt BT_NXT    &bt BT_CLR_ALL  &bt BT_CLR    &studio_unlock  &none         &none       &none      &none      &none  &none
  &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4    &kp C_VOL_UP  &mkp LCLK   &mkp MCLK  &mkp RCLK  &none  &none
  &none  &none         &none         &caps_word      &none         &none           &kp C_VOL_DN  &kp K_MUTE  &none      &none      &none  &none
  &none  &none         &none         &none           &none         &none           &none         &none       &none      &none      &none  &none
            >;
        };

        layer_6 {
            bindings = <
  &none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
  &none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
  &none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
  &none  &none  &none  &none  &none  &studio_unlock  &studio_unlock  &none  &none  &none  &none  &none
            >;
        };

        layer_7 {
            bindings = <
  &none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
  &none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
  &none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
  &none  &none  &none  &none  &none  &studio_unlock  &studio_unlock  &none  &none  &none  &none  &none
            >;
        };

        layer_8 {
            bindings = <
  &none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
  &none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
  &none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
  &none  &none  &none  &none  &none  &studio_unlock  &studio_unlock  &none  &none  &none  &none  &none
            >;
        };

        layer_9 {
            bindings = <
  &none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
  &none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
  &none  &none  &none  &none  &none  &none           &none           &none  &none  &none  &none  &none
  &none  &none  &none  &none  &none  &studio_unlock  &studio_unlock  &none  &none  &none  &none  &none
            >;
        };
    };
};
